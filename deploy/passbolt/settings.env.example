# Copy to settings.env on the server and replace every <PLACEHOLDER>.
# Never commit the real settings.env.
# Back this file up separately to a secure place. It is not in any
# volume (see "Backups" in docs/setup-passbolt.md).

# Public address. Must match the Caddy site block exactly.
APP_FULL_BASE_URL=https://passbolt.example.com
PASSBOLT_SSL_FORCE=true
# Behind Caddy (TLS ends at Caddy, plain HTTP behind it). Caddy sends
# X-Forwarded-Proto. Passbolt reads that header only when BOTH lines
# are set. With the first line alone, SSL_FORCE redirects in a loop.
# The address is the fixed address of Caddy on the "passbolt" network
# (deploy/caddy/compose.yaml).
PASSBOLT_SECURITY_PROXIES_ACTIVE=true
PASSBOLT_SECURITY_PROXIES_TRUSTED_PROXIES=10.84.0.2

# Database. MYSQL_PASSWORD and DATASOURCES_DEFAULT_PASSWORD must be the
# same value: the first sets it in MariaDB, the second uses it.
# Generate one with: openssl rand -hex 32
# Do not use quotes or special characters. An env_file does not
# remove them.
MYSQL_DATABASE=passbolt
MYSQL_USER=passbolt
MYSQL_PASSWORD=<DATABASE_PASSWORD>
MYSQL_RANDOM_ROOT_PASSWORD=true
DATASOURCES_DEFAULT_USERNAME=passbolt
DATASOURCES_DEFAULT_PASSWORD=<DATABASE_PASSWORD>
DATASOURCES_DEFAULT_DATABASE=passbolt

# Mail. Reuses the verified notify.example.com domain from
# docs/setup-mail-sending.md. Use a SEPARATE API key for Passbolt
# (name it "passbolt", sending access, this domain only), so you can
# revoke Bitwarden and Passbolt independently.
# Resend implicit TLS on port 2465 needs the ssl:// prefix and no
# STARTTLS flag. For STARTTLS instead: host without ssl://, port 587,
# EMAIL_TRANSPORT_DEFAULT_TLS=true.
EMAIL_DEFAULT_FROM_NAME=Passbolt
EMAIL_DEFAULT_FROM=no-reply@notify.example.com
EMAIL_TRANSPORT_DEFAULT_HOST=ssl://smtp.resend.com
EMAIL_TRANSPORT_DEFAULT_PORT=2465
EMAIL_TRANSPORT_DEFAULT_USERNAME=resend
EMAIL_TRANSPORT_DEFAULT_PASSWORD=<PASSBOLT_SMTP_API_KEY>
#EMAIL_TRANSPORT_DEFAULT_TLS=true

# Accounts. No self-registration: an admin creates every user.
PASSBOLT_PLUGINS_SELF_REGISTRATION_ENABLED=false

# Login MFA. TOTP here is the second factor for the Passbolt login.
# Storing TOTP seeds as items needs no setting and no license.
PASSBOLT_PLUGINS_MFA_PROVIDERS_TOTP=true
