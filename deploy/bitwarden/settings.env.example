# Copy to settings.env on the server and replace every <PLACEHOLDER>.
# Never commit the real settings.env.
# The built-in daily backup does NOT include this file. Back it up
# separately to a secure place (see "Backups" in docs/setup-bitwarden.md).

# Required
BW_DOMAIN=vault.example.com
BW_DB_PROVIDER=sqlite
BW_DB_FILE=/etc/bitwarden/vault.db

# Get your ID and key from https://bitwarden.com/host/
BW_INSTALLATION_ID=00000000-0000-0000-0000-000000000000
BW_INSTALLATION_KEY=<INSTALLATION_KEY>

# Reverse proxy
# Subnet of the Docker network "bitwarden" (shared with Caddy only). Find it with:
# docker network inspect bitwarden --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
BW_REAL_IPS=<BITWARDEN_SUBNET>

# Mail
# The sender address must be on the domain that you verified with the mail provider.
globalSettings__mail__replyToEmail=<NO_REPLY_ADDRESS>
globalSettings__mail__smtp__host=<SMTP_HOST>
globalSettings__mail__smtp__port=<SMTP_TLS_PORT>
globalSettings__mail__smtp__ssl=true
globalSettings__mail__smtp__username=<SMTP_USERNAME>
globalSettings__mail__smtp__password=<SMTP_PASSWORD>

# Accounts and admin
# IMPORTANT: set to true right after you create your account (setup step 12).
# While it is false, anyone who can reach the vault can create an account.
globalSettings__disableUserRegistration=false
adminSettings__admins=<ADMIN_ADDRESS>

# Services
BW_ENABLE_ICONS=true
BW_ICONS_PROXY_TO_CLOUD=false

# Built-in daily backup to /backups
BACKUP_TIMEZONE=Europe/Berlin
BACKUP_INTERVAL_FORMAT=%Y-%m-%d 03:00:00
BACKUP_RETENTION_DAYS=32
# This settings.env file is not in the archive by default. Preferred: back it
# up separately. Alternative: set BACKUP_INCLUDE_SETTINGS=true and mount this
# file into the container at /settings.env (read-only, readable by UID 911).
# Then every archive also holds the SMTP key and the installation key.
#BACKUP_INCLUDE_SETTINGS=false
