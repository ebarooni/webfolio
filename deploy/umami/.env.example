# Copy to .env on the server and replace every <PLACEHOLDER>.
# Never commit the real .env. Back it up with the database dump
# (see "Backups" in docs/setup-analytics.md).

# Database password. Use hex only, because it is part of a URL:
# openssl rand -hex 32
UMAMI_DB_PASSWORD=<DB_PASSWORD>

# Signs the dashboard login tokens. Generate with:
# openssl rand -hex 32
UMAMI_APP_SECRET=<APP_SECRET>

# Time zone of the container logs.
TZ=Europe/Berlin
